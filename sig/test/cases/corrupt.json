{
  "group": "corrupt",
  "note": "Five tampered forms of the same signed document, each tried against every public key. Corrupt 1 through 4 damage the signature bytes or the fingerprint, so no key matches. Corrupt 5 leaves the header intact and edits the body, so the hash check is what rejects it. None of them declare files, and that is the assertion: a rejected document must not produce output.",
  "cases": [
    {
      "name": "Verify Corrupt 1 Ed25519 Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-ed25519.txt", "ed25519_1_pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-ed25519.txt", "exists": false}
      ]
    },
    {
      "name": "Verify Corrupt 1 ML-DSA-44 Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-mldsa44.txt", "mldsa44_1_pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-mldsa44.txt", "exists": false}
      ]
    },
    {
      "name": "Verify Corrupt 1 ML-DSA-65 Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-mldsa65.txt", "mldsa65_1_pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-mldsa65.txt", "exists": false}
      ]
    },
    {
      "name": "Verify Corrupt 1 ML-DSA-87 Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-mldsa87.txt", "mldsa87_1_pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-mldsa87.txt", "exists": false}
      ]
    },
    {
      "name": "Verify Corrupt 1 RSA Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-rsa.txt", "rsa-pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-rsa.txt", "exists": false}
      ]
    },
    {
      "name": "Verify Corrupt 1 Mixed Public Key",
      "argv": ["verify", "--if", "test_corrupt_1.txt.sig", "--of", "corrupt1-mixed.txt", "mixed_1_pub.pem"],
      "exit": 1,
      "assert": [
        {"target": "corrupt1-mixed.txt", "exists": false}
      ]
    },
